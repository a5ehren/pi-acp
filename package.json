{
  "name": "pi-acp",
  "version": "1.5.2",
  "description": "ACP adapter for pi coding agent",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/svkozak/pi-acp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/svkozak/pi-acp/issues"
  },
  "homepage": "https://github.com/svkozak/pi-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vpx src/index.ts",
    "build": "vp pack",
    "start": "node dist/index.js",
    "format": "vp fmt .",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint .",
    "test": "vp test run",
    "smoke": "node scripts/smoke-acp.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "prepare": "vp config --no-hooks --no-agent",
    "smoke:v2": "node scripts/acp-v2-probe.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.8.0",
    "cross-spawn": "^7.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.19.2",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "vite-plus": "1.7.0",
    "vitest": "5.1.1"
  }
}
